TG_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TG_ADMIN_CHAT_ID=123456789
# 可选；通知发到群组时必须填写实际管理员用户 ID
# TG_ADMIN_USER_ID=123456789
DB_PATH=data/bot.db
LOG_LEVEL=INFO
BOT_LANGUAGE=zh
DISPLAY_TIMEZONE=Asia/Shanghai

# 同一订单最后一笔成交后等待多久再聚合推送（秒）
FILL_BUFFER_SECONDS=3.0

# 连续成交不断到来时，最长等待多久必须推送一次（秒）
FILL_MAX_WAIT_SECONDS=15.0

# 订单更新聚合窗口(秒)，窗口内的多条订单通知会合并为一条消息
ORDER_BUFFER_SECONDS=2.0

# Hyperliquid 每个 IP 最多允许 10 个用户级 WebSocket 订阅
MAX_WS_USERS=10
OUTBOX_POLL_SECONDS=1.0
OUTBOX_RETRY_MAX_SECONDS=300.0
